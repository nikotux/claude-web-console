# === Claude Web Console — plantilla de configuración ===
# Copiá este archivo a .env y completá los valores. NUNCA commitees el .env real.

# Token de acceso = LLAVE MAESTRA. Generá uno con: openssl rand -hex 32
# El login normal es con usuario+contraseña (se administran en /admin y se
# guardan en users.json). Este token queda como acceso admin de emergencia y
# para crear el primer usuario (bootstrap). Se acepta como cookie/header en
# HTTP y en el handshake del WebSocket.
CWC_TOKEN=

# Puerto del servidor. El bind es EXCLUSIVO a la IP ZeroTier (ver CWC_ZT_IFACE).
# Se sirve por HTTPS (cert self-signed auto-generado en certs/, atado a la IP
# ZeroTier). El portapapeles del navegador requiere este contexto seguro.
CWC_PORT=8092

# Interfaz ZeroTier a la que se hace bind. Si se deja vacío, se autodetecta zt*.
CWC_ZT_IFACE=

# Directorio raíz permitido para el árbol de archivos y las terminales.
CWC_HOME=/home/tu_usuario

# Socket tmux dedicado y AISLADO (no interfiere con tu tmux/screen personal).
CWC_TMUX_SOCKET=cwc

# Líneas de scrollback que se guardan en memoria por sesión para re-adjuntar.
CWC_SCROLLBACK=5000

# Días de validez de la sesión de usuario. Las sesiones persisten en
# sessions.json (permisos 600) y sobreviven a reinicios del server.
CWC_SESSION_DAYS=30

# Proyecto principal trackeado (panel con estado git + actualización). Si no
# trabajás con un proyecto externo particular, podés dejarlo vacío o apuntarlo
# a cualquier repo propio.
CWC_PROJECT_DIR=/home/tu_usuario/tu-proyecto
CWC_PROJECT_NAME=tu-proyecto

# === Identidad y cliente de ESTA instancia ===
# Tu email, GitHub, firma y los IDs de departamento/MCP específicos de TU
# organización (si usás el módulo de tickets con Zoho Desk) NO se configuran
# acá: viven en ~/.cwc-data/instance.json, un archivo por-instalación fuera
# del repo (se autogenera al primer arranque). Editalo directo o, más cómodo,
# desde ⚙ Sistema → Variables de entorno (panel admin). Nada de esto son
# secretos — son datos de "quién sos" — así que este .env queda liviano y
# solo con lo que SÍ es sensible/técnico.
